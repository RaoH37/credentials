#!/bin/bash
# Manages the passphrase of the credentials service.
#
#   sudo credentials-passphrase           set the passphrase used by the service
#                                         (the one the database was created
#                                         with, or the one for a new database)
#   sudo credentials-passphrase --change  change the passphrase: re-encrypt the
#                                         database, then update the service
#
# The passphrase is encrypted by systemd-creds (TPM2 when available + host
# key): the .cred file is useless on another machine.
set -euo pipefail

CRED=/etc/credentials/passphrase.cred
CONFIG=/etc/credentials/config.toml
DB=/var/lib/credentials/credentials.db
SERVICE=credentials.service
MIN_LEN=12

usage() { sed -n '4,10s/^# \{0,1\}//p' "$0"; }

MODE="set"
case "${1:-}" in
"") ;;
--change) MODE="change" ;;
-h | --help)
	usage
	exit 0
	;;
*)
	usage >&2
	exit 2
	;;
esac

if [[ $EUID -ne 0 ]]; then
	echo "Must be run as root: sudo $0 $*" >&2
	exit 1
fi

have_systemd() { [[ -d /run/systemd/system ]]; }

# ask_new PROMPT: reads a new passphrase twice into NEW.
ask_new() {
	local p1 p2
	read -rsp "$1" p1
	echo
	read -rsp "Confirm: " p2
	echo
	if [[ ${#p1} -lt $MIN_LEN ]]; then
		echo "The passphrase must be at least $MIN_LEN characters." >&2
		exit 1
	fi
	if [[ $p1 != "$p2" ]]; then
		echo "Passphrases do not match." >&2
		exit 1
	fi
	NEW=$p1
}

start_service() {
	have_systemd || return 0
	systemctl enable --quiet "$SERVICE"
	if systemctl restart "$SERVICE" && sleep 2 && systemctl is-active --quiet "$SERVICE"; then
		echo "credentials service started."
	else
		echo "The service did not start:" >&2
		journalctl -u "$SERVICE" -n 5 --no-pager >&2 || true
		exit 1
	fi
}

if [[ $MODE == change ]]; then
	read -rsp "Current passphrase: " OLD
	echo
	ask_new "New passphrase: "

	was_active=no
	if have_systemd && systemctl is-active --quiet "$SERVICE"; then
		was_active=yes
		echo "Stopping the service..."
		systemctl stop "$SERVICE"
	fi

	# Re-encrypt the database as the service user (owner of the files).
	# Passphrases go through stdin: they never appear in ps.
	if ! printf '%s\n%s\n' "$OLD" "$NEW" |
		runuser -u credentials -- /usr/bin/credentials rekey -config "$CONFIG" -stdin; then
		unset OLD NEW
		echo "Failed: the database and the service passphrase are unchanged." >&2
		if [[ $was_active == yes ]]; then systemctl start "$SERVICE"; fi
		exit 1
	fi
	unset OLD
else
	if [[ -e $DB ]]; then
		echo "A database already exists: enter the passphrase IT WAS CREATED WITH."
		echo "To change it, use: sudo $0 --change"
		echo
		# The existing passphrase may predate the minimum length.
		MIN_LEN=1
	fi
	ask_new "Passphrase: "
fi

printf '%s' "$NEW" | /usr/lib/credentials/encrypt-passphrase "$CRED"
unset NEW
echo "Passphrase encrypted in $CRED."
start_service
