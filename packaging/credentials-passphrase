#!/bin/bash
# Gère la passphrase du service credentials.
#
#   sudo credentials-passphrase           définit la passphrase utilisée par le
#                                         service (celle avec laquelle la base a
#                                         été créée, ou celle d'une nouvelle base)
#   sudo credentials-passphrase --change  change la passphrase : rechiffre la
#                                         base puis met à jour le service
#
# La passphrase est chiffrée par systemd-creds (TPM2 si disponible + clé de
# l'hôte) : le fichier .cred est inutilisable sur une autre machine.
set -euo pipefail

CRED=/etc/credentials/passphrase.cred
CONFIG=/etc/credentials/config.toml
SERVICE=credentials.service

usage() { sed -n '4,9s/^# \{0,1\}//p' "$0"; }

MODE="set"
case "${1:-}" in
"") ;;
--change) MODE=change ;;
-h|--help) usage; exit 0 ;;
*) usage >&2; exit 2 ;;
esac

if [[ $EUID -ne 0 ]]; then
	echo "À lancer en root : sudo $0 $*" >&2
	exit 1
fi

have_systemd() { [[ -d /run/systemd/system ]]; }

ask_new() {
	read -rsp "${1}Passphrase : " P1; echo
	read -rsp "Confirmation : " P2; echo
	if [[ -z $P1 ]]; then echo "Passphrase vide." >&2; exit 1; fi
	if [[ $P1 != "$P2" ]]; then echo "Les passphrases ne correspondent pas." >&2; exit 1; fi
	NEW=$P1
	unset P1 P2
}

start_service() {
	have_systemd || return 0
	systemctl enable --quiet "$SERVICE"
	if systemctl restart "$SERVICE" && sleep 2 && systemctl is-active --quiet "$SERVICE"; then
		echo "Service credentials démarré."
	else
		echo "Le service n'a pas démarré :" >&2
		journalctl -u "$SERVICE" -n 5 --no-pager >&2 || true
		exit 1
	fi
}

if [[ $MODE == change ]]; then
	read -rsp "Passphrase actuelle : " OLD; echo
	ask_new "Nouvelle "

	was_active=no
	if have_systemd && systemctl is-active --quiet "$SERVICE"; then
		was_active=yes
		echo "Arrêt du service…"
		systemctl stop "$SERVICE"
	fi

	# Rechiffrement de la base, avec l'utilisateur du service (propriétaire des
	# fichiers). Les passphrases passent par stdin : invisibles dans ps.
	if ! printf '%s\n%s\n' "$OLD" "$NEW" |
		runuser -u credentials -- /usr/bin/credentials rekey -config "$CONFIG" -stdin; then
		unset OLD NEW
		echo "Échec : la base et la passphrase du service sont inchangées." >&2
		[[ $was_active == yes ]] && systemctl start "$SERVICE"
		exit 1
	fi
	unset OLD
else
	if [[ -e /var/lib/credentials/credentials.db ]]; then
		echo "Une base existe déjà : saisissez la passphrase AVEC LAQUELLE ELLE A ÉTÉ CRÉÉE."
		echo "Pour la changer, utilisez : sudo $0 --change"
		echo
	fi
	ask_new ""
fi

printf '%s' "$NEW" | /usr/lib/credentials/encrypt-passphrase "$CRED"
unset NEW
echo "Passphrase chiffrée dans $CRED."
start_service
