#!/bin/sh
# Usage: encrypt-passphrase FILE.cred < passphrase
# Encrypts the passphrase read from stdin with systemd-creds: TPM2 + host key
# when a TPM2 chip is present, host key only otherwise.
# An empty --tpm2-pcrs= means no binding to the firmware state, so that a
# BIOS or Secure Boot update does not make the passphrase undecryptable.
set -eu
umask 077
out=$1
if systemd-analyze has-tpm2 >/dev/null 2>&1; then
	set -- --with-key=host+tpm2 --tpm2-pcrs=
else
	set -- --with-key=host
fi
install -d -m 0700 "$(dirname "$out")"
tmp=$(mktemp "$out.XXXXXX")
trap 'rm -f "$tmp"' EXIT
# The passphrase goes through stdin: it never appears in ps nor on disk.
tr -d '\n' | systemd-creds encrypt --name=passphrase "$@" - "$tmp"
chmod 0600 "$tmp"
mv -f "$tmp" "$out"
trap - EXIT
