[Unit]
Description=Local credentials vault (HTTP API + admin)
Documentation=file:///usr/share/doc/credentials/README.md
After=network.target
# Without an encrypted passphrase the service does not start: sudo credentials-passphrase
ConditionPathExists=/etc/credentials/passphrase.cred

[Service]
Type=simple
User=credentials
Group=credentials
ExecStart=/usr/bin/credentials -config /etc/credentials/config.toml
# systemd decrypts the passphrase at start-up and exposes it to this service
# only, in $CREDENTIALS_DIRECTORY/passphrase (non-swappable memory, not
# readable by other users).
LoadCredentialEncrypted=passphrase:/etc/credentials/passphrase.cred
StateDirectory=credentials
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5s

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
