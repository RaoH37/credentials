[Unit]
Description=Coffre local de credentials (API HTTP + admin)
Documentation=file:///usr/share/doc/credentials/README.md
After=network.target
# Sans passphrase chiffrée, le service ne démarre pas : sudo credentials-passphrase
ConditionPathExists=/etc/credentials/passphrase.cred

[Service]
Type=simple
User=credentials
Group=credentials
ExecStart=/usr/bin/credentials -config /etc/credentials/config.toml
# systemd déchiffre la passphrase au lancement et l'expose au seul service
# dans $CREDENTIALS_DIRECTORY/passphrase (mémoire non swappable, non lisible
# par les autres utilisateurs).
LoadCredentialEncrypted=passphrase:/etc/credentials/passphrase.cred
StateDirectory=credentials
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5s

# Durcissement
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
