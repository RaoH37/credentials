#!/bin/sh
set -e
case "$1" in
remove)
	[ -d /run/systemd/system ] && systemctl daemon-reload || true
	;;
purge)
	rm -f /etc/credentials/passphrase.cred
	rmdir /etc/credentials 2>/dev/null || true
	if [ -e /usr/share/debconf/confmodule ]; then
		. /usr/share/debconf/confmodule
		db_purge
	fi
	# The database is never deleted automatically.
	if [ -d /var/lib/credentials ]; then
		echo "credentials: the database is kept in /var/lib/credentials (delete it manually)."
	fi
	;;
esac
exit 0
