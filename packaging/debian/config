#!/bin/sh
# debconf questions: asked only when no passphrase is configured yet.
set -e
. /usr/share/debconf/confmodule

[ -e /etc/credentials/passphrase.cred ] && exit 0

# Already answered during pre-configuration (apt may run this script twice).
db_get credentials/passphrase || true
[ -n "$RET" ] && exit 0

MIN_LEN=12
# An existing database keeps the passphrase it was created with.
[ -e /var/lib/credentials/credentials.db ] && MIN_LEN=1

reset_answers() {
	db_set credentials/passphrase ""
	db_set credentials/passphrase-again ""
	db_fset credentials/passphrase seen false
	db_fset credentials/passphrase-again seen false
}

while :; do
	db_input high credentials/passphrase || true
	db_input high credentials/passphrase-again || true
	db_go || true
	db_get credentials/passphrase
	P1="$RET"
	db_get credentials/passphrase-again
	P2="$RET"
	# Empty answer (or non-interactive frontend): configure later.
	[ -z "$P1" ] && break
	if [ "${#P1}" -lt "$MIN_LEN" ]; then
		reset_answers
		db_input critical credentials/passphrase-too-short || true
		db_fset credentials/passphrase-too-short seen false
		continue
	fi
	[ "$P1" = "$P2" ] && break
	reset_answers
	db_input critical credentials/passphrase-mismatch || true
	db_fset credentials/passphrase-mismatch seen false
done
